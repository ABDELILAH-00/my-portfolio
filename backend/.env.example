APP_NAME="Abdelilah Amalas Portfolio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:5173

ADMIN_SECRET_KEY=change_me_in_production
ADMIN_EMAIL=admin@example.com
ADMIN_MATRICULE=0000

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database: MySQL (local) or PostgreSQL (Neon production)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=my_portfolio_db
DB_USERNAME=root
DB_PASSWORD=

# For Neon PostgreSQL (production):
# DB_CONNECTION=pgsql
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

BROADCAST_CONNECTION=log
CACHE_STORE=array
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Cloudinary (production uploads)
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
